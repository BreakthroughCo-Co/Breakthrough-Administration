{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Management OS system user profile and role assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "PRACTITIONER", "VIEWER"] },
        "position": { "type": "string" },
        "workerScreeningStatus": { "type": "string" },
        "workerScreeningExpiry": { "type": "string" },
        "policeCheckExpiry": { "type": "string" },
        "ndisOrientationDone": { "type": "boolean" },
        "activeCaseload": { "type": "number" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Client": {
      "title": "NDIS Participant / Client",
      "description": "Master record for NDIS participant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ndisNumber": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "primaryDisability": { "type": "string" },
        "totalBudget": { "type": "number" },
        "spentBudget": { "type": "number" },
        "riskLevel": { "type": "string" }
      },
      "required": ["id", "ndisNumber", "name", "status"]
    },
    "CaseNote": {
      "title": "Clinical Case Note",
      "description": "Session progress note recorded by practitioner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "practitionerId": { "type": "string" },
        "date": { "type": "string" },
        "format": { "type": "string" },
        "subjective": { "type": "string" },
        "objective": { "type": "string" },
        "assessment": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientId", "practitionerId", "date"]
    },
    "Incident": {
      "title": "Incident Record",
      "description": "Incident report and NDIS Quality & Safeguards notification tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "severity": { "type": "string" },
        "isNdisReportable": { "type": "boolean" },
        "status": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "clientId", "severity", "status"]
    },
    "RestrictivePractice": {
      "title": "Restrictive Practice Record",
      "description": "Regulated restrictive practice entry and authorization status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "practiceType": { "type": "string" },
        "status": { "type": "string" },
        "authorizationBody": { "type": "string" },
        "expiryDate": { "type": "string" }
      },
      "required": ["id", "clientId", "practiceType", "status"]
    },
    "Lead": {
      "title": "CRM Intake Lead",
      "description": "Prospective client lead and sales/onboarding intake",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prospectName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "stage": { "type": "string" },
        "estimatedPlanValue": { "type": "number" }
      },
      "required": ["id", "prospectName", "stage"]
    },
    "ABCLog": {
      "title": "ABC Behaviour Log",
      "description": "Antecedent-Behaviour-Consequence behavioral tracking entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "timestamp": { "type": "string" },
        "antecedent": { "type": "string" },
        "behavior": { "type": "string" },
        "consequence": { "type": "string" },
        "intensity": { "type": "number" }
      },
      "required": ["id", "clientId", "timestamp", "behavior"]
    },
    "BSPDocument": {
      "title": "Behaviour Support Plan Document",
      "description": "Comprehensive or Interim Behaviour Support Plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["id", "clientId", "version", "status"]
    },
    "BillingClaim": {
      "title": "NDIS Billing Claim",
      "description": "Support item billing claim for NDIS PACE processing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "serviceDate": { "type": "string" },
        "ndisSupportItem": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "clientId", "serviceDate", "totalAmount"]
    },
    "AuditLog": {
      "title": "System Audit Log",
      "description": "Audit record of critical actions and system events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "actorId", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "System user profiles and roles"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Master NDIS participants collection"
    },
    "/case_notes/{noteId}": {
      "schema": { "$ref": "#/entities/CaseNote" },
      "description": "Clinical case notes collection"
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Incidents and NDIS Commission reporting"
    },
    "/restrictive_practices/{practiceId}": {
      "schema": { "$ref": "#/entities/RestrictivePractice" },
      "description": "Regulated restrictive practice registry"
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "CRM prospective leads"
    },
    "/abc_logs/{logId}": {
      "schema": { "$ref": "#/entities/ABCLog" },
      "description": "ABC behavioral tracking entries"
    },
    "/bsps/{bspId}": {
      "schema": { "$ref": "#/entities/BSPDocument" },
      "description": "Behaviour Support Plans"
    },
    "/billing_claims/{claimId}": {
      "schema": { "$ref": "#/entities/BillingClaim" },
      "description": "NDIS billing and PACE claim entries"
    },
    "/audit_logs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trails for compliance"
    }
  }
}
