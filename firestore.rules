rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins or authorized practitioners check
    function isStaff() {
      return isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow update: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if false; // Profiles shouldn't be hard-deleted
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().name is string && incoming().ndisNumber is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Case Notes Collection
    match /case_notes/{noteId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string && incoming().practitionerId is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Incidents Collection
    match /incidents/{incidentId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string && incoming().severity is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Restrictive Practices
    match /restrictive_practices/{practiceId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string && incoming().practiceType is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // CRM Leads
    match /leads/{leadId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().prospectName is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ABC Logs
    match /abc_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string && incoming().behavior is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // BSP Documents
    match /bsps/{bspId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Billing Claims
    match /billing_claims/{claimId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().clientId is string && incoming().serviceDate is string;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Immutable Audit Logs
    match /audit_logs/{auditId} {
      allow read: if isStaff();
      allow create: if isStaff() && incoming().actorId is string && incoming().action is string;
      allow update: if false; // Immutable
      allow delete: if false; // Immutable
    }
  }
}
